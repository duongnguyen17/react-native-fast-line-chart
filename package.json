{
  "name": "@2security/fast-line-chart",
  "version": "0.1.3",
  "description": "⚡ Ultra-fast real-time streaming LineChart for React Native with zero re-renders & hardware VSync throttling built on Nitro Modules",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "@2security/fast-line-chart-source": "./src/index.tsx",
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./nitrogen/generated/shared/json/*": "./nitrogen/generated/shared/json/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @2security/fast-line-chart-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "nitrogen": "nitrogen",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "release": "release-it --only-version",
    "publish": "npm publish --access public"
  },
  "keywords": [
    "react-native",
    "line-chart",
    "charts",
    "streaming",
    "realtime",
    "performance",
    "nitro-modules",
    "zero-rerender",
    "fabric",
    "mpandroidchart",
    "dgcharts",
    "ios",
    "android",
    "2security"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duongnguyen17/react-native-fast-line-chart.git"
  },
  "author": "2Security <duongthptnt@gmail.com> (https://github.com/duongnguyen17)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/duongnguyen17/react-native-fast-line-chart/issues"
  },
  "homepage": "https://github.com/duongnguyen17/react-native-fast-line-chart#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "commitlint": "^19.8.1",
    "del-cli": "^8.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^29.7.0",
    "lefthook": "^2.0.3",
    "nitrogen": "^0.37.2",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.44.1",
    "react-native-nitro-modules": "^0.37.2",
    "release-it": "^19.0.4",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "^0.37.2"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.18.1",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "nitro-view",
    "languages": "kotlin-swift",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it"
    ],
    "version": "0.64.0"
  }
}
